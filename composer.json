{
  "name": "roogul/seo-by-roogul",
  "description": "Straightforward SEO for Craft CMS: global defaults, per-entry overrides, social meta, JSON-LD, XML sitemaps and robots.txt.",
  "type": "craft-plugin",
  "license": "MIT",
  "keywords": ["craft", "cms", "craftcms", "craft-plugin", "seo", "meta", "open graph", "sitemap", "robots", "json-ld", "schema"],
  "authors": [
    {
      "name": "ROOGUL",
      "homepage": "https://roogul.com"
    }
  ],
  "support": {
    "docs": "https://github.com/roogul/seo-by-roogul/blob/main/README.md",
    "issues": "https://github.com/roogul/seo-by-roogul/issues"
  },
  "require": {
    "php": "^8.2",
    "craftcms/cms": "^5.0.0"
  },
  "autoload": {
    "psr-4": {
      "roogul\\seo\\": "src/"
    }
  },
  "extra": {
    "handle": "seo-by-roogul",
    "name": "SEO by ROOGUL",
    "developer": "ROOGUL",
    "developerUrl": "https://roogul.com",
    "documentationUrl": "https://github.com/roogul/seo-by-roogul/blob/main/README.md",
    "changelogUrl": "https://raw.githubusercontent.com/roogul/seo-by-roogul/main/CHANGELOG.md",
    "class": "roogul\\seo\\Plugin"
  },
  "config": {
    "allow-plugins": {
      "yiisoft/yii2-composer": true,
      "craftcms/plugin-installer": true
    }
  }
}
